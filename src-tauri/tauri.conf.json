{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MesaLista",
  "version": "0.1.0",
  "identifier": "com.johan.restaurant-app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MesaLista",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Johan Dev",
    "copyright": "© 2026 Johan Dev",
    "category": "Business",
    "shortDescription": "Restaurant point of sale, orders and table management.",
    "longDescription": "A native, offline-first point of sale for restaurants. Manage tables, orders, kitchen tickets, payments, users and reports. All data stays on your machine.",
    "homepage": "https://github.com/joh4ndev/restaurant-app",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}